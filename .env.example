# WHMCS MCP Server — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# All values below are placeholders only.

# --- Required: WHMCS External API connection ---

# Base URL of the WHMCS installation's API endpoint (the includes/api.php path
# is appended by the client at request time). Must be https:// in production.
# Example: https://billing.example.com
WHMCS_API_URL=https://your-whmcs-domain.example.com

# WHMCS API Credentials identifier (Setup > Staff Management > API Credentials).
# NOT your admin username — API Credentials are a separate identifier/secret pair
# scoped to an API Role with per-action permissions.
WHMCS_API_IDENTIFIER=your_api_identifier_here

# WHMCS API Credentials secret. Treat like a password; rotate if ever exposed.
WHMCS_API_SECRET=your_api_secret_here

# --- Optional: WHMCS API access key ---

# Only required if the WHMCS installation has "Require API Access Key" enabled
# under API Security settings, instead of (or in addition to) an IP allowlist.
# Leave unset if not used.
#WHMCS_API_ACCESS_KEY=

# --- MCP server safety/mode configuration ---

# Controls which tool tiers are advertised to the model.
#   readonly (default) - only [read] tier tools are exposed
#   write              - [read] and [write] tier tools are exposed
#   full               - all tiers, including [billing] and [destructive],
#                        are exposed. NEVER set this in a production/3VS
#                        deployment; invoices remain operator-manual.
WHMCS_MCP_MODE=readonly

# Comma-separated list of tool domains to enable. Omit to enable all domains
# allowed by WHMCS_MCP_MODE.
# Available domains: system,tickets,clients,products,invoices,domains,orders
#WHMCS_MCP_ENABLE_DOMAINS=tickets,clients,products

# Whether to redact PII (email, phone, address) from tool results in addition
# to secrets/credentials, which are always redacted regardless of this flag.
# true (default) | false
WHMCS_MCP_REDACT_PII=true

# Per-request timeout to the WHMCS API, in milliseconds.
WHMCS_MCP_TIMEOUT_MS=15000

# Token-bucket rate limit: max requests per second issued to the WHMCS API.
WHMCS_MCP_RATE_LIMIT=5

# Set to "1" only for local development against a non-HTTPS WHMCS instance.
# Never set this in production.
#WHMCS_MCP_ALLOW_INSECURE=

# --- Optional: transport ---

# Uncomment to run over Streamable HTTP (bound to 127.0.0.1) instead of the
# default stdio transport. Value is the local port to bind.
#WHMCS_MCP_HTTP_PORT=3939
